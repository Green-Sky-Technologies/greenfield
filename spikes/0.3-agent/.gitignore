/figcraft/
/target/
/build.log
# The root .gitignore ignores out/; keep results here (PNGs, metrics, report), not transcripts.
!out/
out/**/transcript.json
out-scripted/**/transcript.json
# Repeat runs (variance): keep metrics and reports only.
out-var/**/transcript.json
out-var/**/*.png
out-var/**/*.figcraft
