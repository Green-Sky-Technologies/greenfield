+
+/// [`paint_app_icon`] on a painter: `ink` for the selection box and handles, `accent` (field
+/// green) for the field rising inside it.
+pub fn paint_mark(painter: &egui::Painter, rect: egui::Rect, t: &Tokens) {
+    let ppp = painter.ctx().pixels_per_point();
+    let cell = ((rect.width().min(rect.height()) / 16.0 * ppp).floor() / ppp).max(1.0 / ppp);
+    let origin = rect.center() - egui::vec2(cell * 8.0, cell * 8.0);
+    let origin = egui::pos2((origin.x * ppp).round() / ppp, (origin.y * ppp).round() / ppp);
+    for (rows, color) in [(&crate::greenfield_mark::INK, t.icon), (&crate::greenfield_mark::FIELD, t.accent)] {
+        for (y, bits) in rows.iter().enumerate() {
+            for x in 0..16 {
+                if bits >> x & 1 == 1 {
+                    let min = origin + egui::vec2(x as f32 * cell, y as f32 * cell);
+                    painter.rect_filled(egui::Rect::from_min_size(min, egui::vec2(cell, cell)), egui::CornerRadius::ZERO, color);
+                }
+            }
+        }
+    }
 }
 
